{
  "sourceLanguage": "en",
  "strings": {
    "Add a person to start the timeline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a person to start the timeline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个联系人以开始生日时间线。"
          }
        }
      },
      "comment": "Empty-state description shown on the main timeline when no people have been added yet."
    },
    "Add Birthday": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Birthday"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加生日"
          }
        }
      },
      "comment": "Navigation title for the form used to create a new birthday/person entry."
    },
    "Add Person": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Person"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加联系人"
          }
        }
      },
      "comment": "Toolbar button title on the main birthdays timeline. Opens the add birthday/person form."
    },
    "Appearance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      },
      "comment": "Settings section title for app appearance options."
    },
    "appearance.mode.dark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        }
      },
      "comment": "Appearance mode option: force the app to use dark mode."
    },
    "appearance.mode.light": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色"
          }
        }
      },
      "comment": "Appearance mode option: force the app to use light mode."
    },
    "appearance.mode.system": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow System"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      },
      "comment": "Appearance mode option: follow the device system appearance setting."
    },
    "Birth date": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birth date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出生日期"
          }
        }
      },
      "comment": "Label for the date picker in the add birthday form. Refers to the person’s date of birth."
    },
    "Birthday": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthday"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生日"
          }
        }
      },
      "comment": "Section title in the add form for birthday date and calendar fields. Singular noun."
    },
    "birthday.age.accessibility.format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将 %lld 岁"
          }
        }
      },
      "comment": "VoiceOver label for the age number shown in a birthday row. Contains one integer placeholder for the age the person will turn, e.g. “Turns 30”. Preserve the numeric placeholder."
    },
    "Birthdays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthdays"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生日"
          }
        }
      },
      "comment": "Main app title and widget header. Plural noun referring to tracked birthdays."
    },
    "Calendar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历"
          }
