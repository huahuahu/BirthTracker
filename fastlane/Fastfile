default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight build"
  lane :beta do
    setup_ci if ENV["CI"]
    build_app(
      scheme: "BirthTracker",
      export_method: "app-store",
      skip_profile_detection: true
    )
    upload_to_testflight(
      api_key: app_store_connect_api_key_from_env
    )
  end

  desc "Build and submit for App Store review"
  lane :release do
    setup_ci if ENV["CI"]
    build_app(
      scheme: "BirthTracker",
      export_method: "app-store",
      skip_profile_detection: true
    )
    upload_to_app_store(
      api_key: app_store_connect_api_key_from_env,
      submit_for_review: true,
      automatic_release: false
    )
  end

  private_lane :app_store_connect_api_key_from_env do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8")
    )
  end
end
